# Secrets / configuration locale (NE JAMAIS versionner)
config.json

# Environnement virtuel
.venv/
venv/

# Interface React : les dependances ne sont pas versionnees.
# frontend/dist (interface construite) EST versionne : les postes
# utilisateurs n'ont pas besoin de Node.js.
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Données générées localement
data/*.db
reports/
uploads/
logs/
*.log

# Divers OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Construction Windows (packaging/build.ps1). Motifs ancrés à la racine :
# frontend/dist doit rester versionné.
/.venv-package/
/build/
/dist/
/release/
/*.spec
